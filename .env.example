# ── Transport ──────────────────────────────────────────────────────────
# MCP_TRANSPORT_TYPE=stdio          # stdio | http (default: stdio)
# MCP_HTTP_PORT=3010                # HTTP port (default: 3010)
# MCP_HTTP_HOST=127.0.0.1           # HTTP host (default: 127.0.0.1)
# MCP_HTTP_ENDPOINT_PATH=/mcp      # HTTP endpoint path (default: /mcp)
# MCP_HTTP_MAX_BODY_BYTES=1048576  # Max request body bytes; 413 over limit, 0 disables (default: 1048576)
# MCP_PUBLIC_URL=                  # Public origin behind a TLS-terminating proxy (e.g. https://mcp.example.com)

# ── Auth ──────────────────────────────────────────────────────────────
# MCP_AUTH_MODE=none                # none | jwt | oauth (default: none)
# MCP_AUTH_SECRET_KEY=              # JWT secret (required for jwt mode)
# MCP_REQUEST_STATE_KEY=            # Opt-in, >= 32 bytes, same on every instance: seals the requestState
                                    # handlers return; any other state is rejected before the handler runs

# ── Storage ───────────────────────────────────────────────────────────
# STORAGE_PROVIDER_TYPE=in-memory   # in-memory | filesystem | supabase | cloudflare-r2 | cloudflare-kv | cloudflare-d1

# ── Session ──────────────────────────────────────────────────────────
MCP_SESSION_MODE=stateless          # stateful | stateless | auto. Set here, not left to the schema default
                                    # (auto, which resolves to stateful). Stateless fits a data API:
                                    # no session store, horizontally scalable. Use stateful when a tool
                                    # asks the caller for input mid-handler (ctx.requestInput).
# MCP_HTTP_RESUMABILITY=false       # SSE replay on a dropped stateful stream. Default: true.
                                    # Kill switch only — no effect on stateless serving.
# MCP_HTTP_RESUMABILITY_MAX_EVENTS=512   # Retained per session, oldest evicted first
# MCP_HTTP_RESUMABILITY_TTL_MS=300000    # How long a retained event stays replayable

# ── Memory ───────────────────────────────────────────────────────────
# MCP_GC_PRESSURE_INTERVAL_MS=0     # Opt-in forced Bun.gc(true) interval, ms (Bun only). Drains old-gen backlog
                                    # under sustained HTTP load (issue #50). Try 60000 if RSS grows. Default: 0.

# ── Logging ───────────────────────────────────────────────────────────
# MCP_LOG_LEVEL=info                # debug | info | notice | warning | error
# MCP_LOG_RATE_LIMIT_THRESHOLD=10   # Max emissions per level+message per window; 0 disables
# MCP_LOG_RATE_LIMIT_WINDOW_MS=60000
# LOG_TOOL_FAILURE_PAYLOADS=false            # Log failed tool calls' arguments + result (key-name redaction only;
                                             # secrets in free-form values are kept). Reaches stderr, files, and OTLP
# LOG_TOOL_FAILURE_PAYLOAD_MAX_BYTES=16384   # Per-payload cap, UTF-8 bytes

# ── Telemetry ─────────────────────────────────────────────────────────
# OTEL_ENABLED=false                          # Enable OpenTelemetry (default: false)
# OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP base URL (e.g., http://localhost:4318); traces → /v1/traces, metrics → /v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=        # Overrides the base for traces; used as-is
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=       # Overrides the base for metrics; used as-is
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=          # Opt-in log export (e.g., http://localhost:4318/v1/logs); the base never enables it

# ── Dataframe canvas (DataCanvas, off by default) ────────────────────
# Enabling it lists eurostat_dataframe_describe / eurostat_dataframe_query, lets
# eurostat_query_dataset stage a match larger than its 5,000-row inline cap as a SQL
# table, and lets eurostat_download_dataset retain a whole bulk download instead of
# only its preview. The DuckDB binding ships with the server, so this is the only switch.
# eurostat_dataframe_drop also needs EUROSTAT_DATAFRAME_DROP_ENABLED=true (below).
# CANVAS_PROVIDER_TYPE=none                   # none | duckdb (default: none)
# CANVAS_TEMP_PATH=                           # Parent directory for DuckDB spill files (default: the OS temp
                                              # directory). A private mcp-canvas-XXXXXX directory is created
                                              # inside it, so it must be writable by the server process.
# CANVAS_TTL_MS=86400000                      # Staged tables' sliding lifetime in ms (default: 24h)
# CANVAS_DEFAULT_ROW_LIMIT=10000              # Max rows one eurostat_dataframe_query returns (default: 10000)

# ── Server-specific ──────────────────────────────────────────────────
# EUROSTAT_BASE_URL=https://ec.europa.eu/eurostat/api/dissemination  # API base URL (default shown)
# EUROSTAT_COMEXT_BASE_URL=https://ec.europa.eu/eurostat/api/comext/dissemination
                                                                      # Comext host, serving every DS-* dataset code (default shown)
# EUROSTAT_REQUEST_TIMEOUT_MS=30000                                   # HTTP request timeout in ms (default: 30000)
# EUROSTAT_METADATA_TIMEOUT_MS=120000                                 # Timeout for one dataset's SDMX dataflow structure in ms,
                                                                      # 23 MB for DS-045409 (default: 120000 — 2m)
# EUROSTAT_TOC_CACHE_TTL_MS=43200000                                  # Catalogue TOC cache lifetime in ms (default: 43200000 — 12h)
# EUROSTAT_BULK_TIMEOUT_MS=120000                                     # eurostat_download_dataset transfer timeout in ms (default: 120000 — 2m)
# EUROSTAT_BULK_MAX_BYTES=52428800                                    # Byte budget per bulk download, counted on the decoded TSV
                                                                      # and enforced while streaming (default: 52428800 — 50 MiB)
# EUROSTAT_DATAFRAME_DROP_ENABLED=false                               # Lists eurostat_dataframe_drop, which removes one staged table;
                                                                      # needs CANVAS_PROVIDER_TYPE=duckdb (default: false)
