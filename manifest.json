{
  "manifest_version": "0.3",
  "name": "eurostat-mcp-server",
  "version": "0.11.1",
  "description": "Search and query the Eurostat catalogue \u2014 EU economy, demography, trade, health, and NUTS regional data via MCP. STDIO or Streamable HTTP.",
  "author": {
    "name": "cyanheads",
    "email": "casey@caseyjhand.com",
    "url": "https://caseyjhand.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cyanheads/eurostat-mcp-server"
  },
  "homepage": "https://github.com/cyanheads/eurostat-mcp-server#readme",
  "license": "Apache-2.0",
  "server": {
    "type": "node",
    "entry_point": "dist/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/dist/index.js"],
      "env": {
        "MCP_TRANSPORT_TYPE": "stdio",
        "MCP_AUTH_MODE": "none",
        "NODE_ENV": "production",
        "CANVAS_PROVIDER_TYPE": "none",
        "EUROSTAT_CLAMP_LIMITS": "${user_config.clamp_limits}"
      }
    }
  },
  "compatibility": {
    "runtimes": {
      "node": ">=24.0.0"
    }
  },
  "tools_generated": true,
  "prompts_generated": true,
  "user_config": {
    "clamp_limits": {
      "type": "boolean",
      "title": "Clamp read limits",
      "description": "Clamp positive integer preview/search/dimension limits to 500/100/1000 with a notice. Disable to reject over-cap inputs.",
      "default": true,
      "required": false
    }
  }
}
